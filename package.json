{
  "name": "gapcue",
  "version": "0.6.2",
  "private": true,
  "description": "Browser research desk for public GitHub, Hacker News, and Stack Overflow sources.",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:browser": "node tests/browser.cjs",
    "test:research": "node tests/research-browser.cjs",
    "test:repos": "node tests/repo-browser.cjs",
    "test:compare": "node tests/compare-browser.cjs",
    "test:atlas": "node tests/atlas-browser.cjs",
    "test:provenance": "node tests/repo-hn-provenance.cjs",
    "test:hn-repo": "node tests/hn-linked-repo.cjs",
    "test:hn-find-repos": "node tests/hn-find-repos.cjs",
    "test:stackoverflow": "node tests/stackoverflow-browser.cjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
