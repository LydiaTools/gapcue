{
  "name": "gapcue",
  "version": "0.6.0",
  "private": true,
  "description": "Browser research desk for public GitHub issues and Hacker News discussions.",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:browser": "node tests/browser.cjs",
    "test:research": "node tests/research-browser.cjs",
    "test:repos": "node tests/repo-browser.cjs",
    "test:compare": "node tests/compare-browser.cjs",
    "test:atlas": "node tests/atlas-browser.cjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
